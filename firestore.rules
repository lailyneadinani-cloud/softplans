rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  Soft Plans — règles de sécurité Firestore
//  1. Remplace les deux adresses ci-dessous par la tienne et celle de ton amie
//     (les adresses Gmail / Google avec lesquelles vous vous connectez).
//  2. Colle tout ce fichier dans Firebase > Firestore > Règles > Publier.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'TON.ADRESSE@gmail.com',
          'ADRESSE.DE.TON.AMIE@gmail.com'
        ];
    }

    // Espace personnel : tâches, objectifs, mood board, réglages.
    // Visible et modifiable uniquement par la personne concernée.
    match /data/users/{uid}/{rest=**} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }

    // Qui est dans le duo (2 personnes maximum, personne ne peut en retirer une autre).
    match /duo/state {
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.members.size() <= 2
        && request.auth.uid in request.resource.data.members;
      allow update: if allowed()
        && request.resource.data.members.size() <= 2
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.uid in request.resource.data.members;
    }
    // Petit verrou pour éviter que vous entriez exactement en même temps.
    match /duo/claim {
      allow read, write: if allowed();
    }

    // Chacun écrit seulement sa propre fiche (prénom, compteurs, illustration).
    match /pstats/{uid} {
      allow read: if allowed();
      allow write: if allowed() && request.auth.uid == uid;
    }
    match /profiles/{uid} {
      allow read: if allowed();
      allow write: if allowed() && request.auth.uid == uid;
    }

    // Éléments partagés en lecture seule : seul le propriétaire les modifie.
    match /mirrors/{id} {
      allow read: if allowed();
      allow create: if allowed() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if allowed() && resource.data.ownerId == request.auth.uid;
    }

    // Espace commun : projets, tâches communes, commentaires.
    match /projects/{id} { allow read, write: if allowed(); }
    match /stasks/{id}   { allow read, write: if allowed(); }
    match /scomments/{id} { allow read, write: if allowed(); }

    // Tout le reste est refusé.
  }
}
